<?xml version="1.0" encoding="utf-8"?>
<!-- Butter pill button (MULAI PERJALANAN). Slightly thicker ink border
     so it reads as a primary CTA. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_butter" />
    <stroke
        android:width="1.5dp"
        android:color="@color/widget_ink" />
    <corners android:radius="10dp" />
</shape>
